PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reverse
JWT_SECRET=change-this-to-a-long-random-string

# M-Pesa (Daraja). Sandbox first; switch MPESA_ENV=production with live keys later.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS address of this server (ngrok/your domain), no trailing path. Optional while testing.
MPESA_CALLBACK_URL=
# Use CustomerBuyGoodsOnline if you collect on a Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email (Gmail + app password). Needs 2-Step Verification on the Gmail account.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Reverse <yourproject@gmail.com>
# Where the dashboard link in emails points (your site address when online)
APP_URL=http://localhost:5173

# Hosted database (Aiven, etc.): set the port they give you and turn on encryption
DB_PORT=3306
DB_SSL=false
# Optional, better than DB_SSL: paste the provider's CA certificate (use \n for new lines)
DB_SSL_CA=

# Shown on the Pricing page while online M-Pesa is switched off (phone or email to pay manually)
PAYMENT_CONTACT=
